# Never place real credentials in this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://localhost:3000"

# Configure a random secret and call /api/internal/round-scheduler every minute with Authorization: Bearer <ROUND_SCHEDULER_SECRET>.
# The scheduler prepares a rolling 48-hour schedule and processes due close/draw events.
# ROUND_SCHEDULER_SECRET="replace-with-a-long-random-secret"

# Mercado Pago Pix Orders API. Never commit real values to this file.
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""
# MERCADOPAGO_PAYER_EMAIL_DOMAIN="jogaplaca.com.br"
# APP_BASE_URL="https://your-development-domain.example"

# Encrypts Pix keys saved with withdrawal requests. Generate 32 random bytes and provide as 64 hex chars or base64; keep stable across restarts and never commit the real key.\n# WALLET_PIX_ENCRYPTION_KEY="replace-with-32-random-bytes-in-hex-or-base64"\n\n# One-time admin bootstrap inputs only; inject temporarily for the command and remove afterward.
# ADMIN_USERNAME=
# ADMIN_INITIAL_PASSWORD=
# CONFIRM_ADMIN_PROVISIONING=CREATE_FIRST_ADMIN


# Official prize-redemption support contact. Digits only, including country code and area code.
# Configure the approved platform WhatsApp number in the deployment environment; do not commit real/private contact details.
# NEXT_PUBLIC_PRIZE_SUPPORT_WHATSAPP="55DDDNXXXXXXXX"
