generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  CASHIER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum RoundStatus {
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT
  PURCHASE_DEBIT
  PRIZE_CREDIT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAID
  REFUND
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

model User {
  id                    String        @id @default(cuid())
  username              String        @unique
  passwordHash          String
  role                  UserRole      @default(PLAYER)
  status                AccountStatus @default(ACTIVE)
  mustChangePassword    Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  purchasesAsPlayer     Purchase[]    @relation("PlayerPurchases")
  purchasesAsCashier    Purchase[]    @relation("CashierPurchases")
  ledgerEntries         LedgerEntry[]
  withdrawals           Withdrawal[]  @relation("WithdrawalOwner")
  reviewedWithdrawals   Withdrawal[]  @relation("WithdrawalReviewer")
  auditEvents           AuditEvent[]  @relation("AuditActor")
  settingsChanged       SettingChange[] @relation("SettingChanger")
  commissions           CashierCommission[]
  customersCreated      Customer[]              @relation("CustomerCreator")
  withdrawalHistoryActions WithdrawalStatusHistory[] @relation("WithdrawalHistoryActor")

  @@index([role, status])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
  createdBy   User?    @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([phone])
  @@index([createdAt])
}

model Round {
  id              String                   @id @default(cuid())
  code            String                   @unique
  startsAt        DateTime
  cutoffAt        DateTime
  resultAt        DateTime
  status          RoundStatus               @default(SCHEDULED)
  resultPlate     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  participations  PurchaseParticipation[]

  @@index([status, startsAt])
  @@index([resultAt])
  @@index([cutoffAt, status])
}

model Purchase {
  id                String        @id @default(cuid())
  playerId          String?
  cashierId         String?
  customerId        String?
  status            PurchaseStatus @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod
  totalCents        Int
  currency          String        @default("BRL")
  receiptCode       String        @unique
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  player            User?         @relation("PlayerPurchases", fields: [playerId], references: [id], onDelete: Restrict)
  cashier           User?         @relation("CashierPurchases", fields: [cashierId], references: [id], onDelete: Restrict)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  participations    PurchaseParticipation[]
  payment           Payment?
  ledgerEntries     LedgerEntry[]
  commission        CashierCommission?

  @@index([playerId, createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model PurchaseParticipation {
  id             String              @id @default(cuid())
  purchaseId     String
  roundId        String
  status         ParticipationStatus @default(PENDING)
  totalCents     Int
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?
  purchase       Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  round          Round               @relation(fields: [roundId], references: [id], onDelete: Restrict)
  lines          ParticipationLine[]
  ledgerEntries  LedgerEntry[]

  @@unique([purchaseId, roundId])
  @@index([roundId, status, createdAt])
  @@index([purchaseId, status])
}

model ParticipationLine {
  id                    String   @id @default(cuid())
  participationId       String
  plateDisplay          String
  normalizedPlate       String
  unitCents             Int
  tensCents             Int
  hundredsCents         Int
  thousandsCents        Int
  lettersCents          Int
  fullPlateCents        Int
  ruleVersion           String
  ruleSnapshot          Json
  prizeCents            Int?
  prizeCreditedAt       DateTime?
  createdAt             DateTime @default(now())
  participation         PurchaseParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([normalizedPlate])
  @@index([participationId])
}

model Payment {
  id                    String        @id @default(cuid())
  purchaseId            String        @unique
  provider              String
  providerPaymentId     String?
  idempotencyKey        String        @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  confirmedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  purchase              Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  webhookEvents         WebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
}

model WebhookEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  payloadDigest     String
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  processingError   String?
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  userId           String
  purchaseId       String?
  participationId  String?
  withdrawalId     String?
  type             LedgerEntryType
  amountCents      Int
  currency         String          @default("BRL")
  idempotencyKey   String          @unique
  description      String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase         Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  participation    PurchaseParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)
  withdrawal       Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([purchaseId])
  @@index([participationId])
  @@index([withdrawalId])
}

model CashierCommission {
  id                    String   @id @default(cuid())
  purchaseId            String   @unique
  cashierId             String
  rateBasisPoints       Int
  amountCents           Int
  createdAt             DateTime @default(now())
  purchase              Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashier               User     @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([cashierId, createdAt])
}

model Withdrawal {
  id                  String                 @id @default(cuid())
  userId              String
  amountCents         Int
  pixKeyEncrypted     String
  status              WithdrawalStatus       @default(PENDING)
  idempotencyKey      String                 @unique
  reviewedById        String?
  providerRef         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy          User?                  @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  statusHistory       WithdrawalStatusHistory[]
  ledgerEntries       LedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([reviewedById, updatedAt])
}

model WithdrawalStatusHistory {
  id            String           @id @default(cuid())
  withdrawalId  String
  fromStatus    WithdrawalStatus?
  toStatus      WithdrawalStatus
  actorId       String?
  note          String?
  createdAt     DateTime         @default(now())
  withdrawal    Withdrawal      @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor         User?            @relation("WithdrawalHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
}

model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt
  changes    SettingChange[]
}

model SettingChange {
  id           String   @id @default(cuid())
  settingKey   String
  oldValue     String?
  newValue     String
  changedById  String
  changedAt    DateTime @default(now())
  setting      Setting  @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy    User     @relation("SettingChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([settingKey, changedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
